---
import Header from '../components/base/header/Header.astro'
import Sidebar from '../components/base/sidebar/Sidebar.astro'
import '../styles/global.css'
---

<!doctype html>
<html lang="pt-br">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="font-poppins bg-bg-secondary text-white p-bs">
		<Header />
		<Sidebar />
		<slot />
	</body>

	<!-- <script defer slot="body-scripts" src="../scripts/brawlers.js"></script> -->

	<script defer>

function getById(id) {
    return document.getElementById(id);
}

function queryAll(className) {
    return document.querySelectorAll(className);
}

const openBrawlBoxBtn = getById('brawl-box');
openBrawlBoxBtn?.addEventListener('click', () => {
	openBrawlBox()
});

const openBigBoxBtn = getById('big-box');
openBigBoxBtn?.addEventListener('click', () => {
	openBigBox()
});

const openMegaBoxBtn = getById('mega-box');
openMegaBoxBtn?.addEventListener('click', () => {
	openMegaBox()
});

function openBrawlBox() {
	
	let storage = getStorage();

	// powerPointsDraw(2, "brawl-box");

	let generalResources = generalDraw(1, "brawl-box");

	storage.coins += parseInt(generalResources.totalCoinsReward) || 0;
	storage.powerPoints += parseInt(generalResources.totalPowerPointsReward) || 0;
	storage.credits += parseInt(generalResources.totalCreditsReward) || 0;
	storage.gems += parseInt(generalResources.totalGemsReward) || 0;
	
	localStorage.setItem('coins', storage.coins);
	localStorage.setItem('powerPoints', storage.powerPoints);
	localStorage.setItem('credits', storage.credits);
	localStorage.setItem('gems', storage.gems);

    updateResources();

	openingDelay();
}

function openBigBox() {

	let bigBoxCount = localStorage.getItem('bigBoxCount') || 0;
	
	if (bigBoxCount <= 0) {
		console.log('oi');
		
		return window.location.href = "/BrawlStarsSimulator/shop";
	}

	bigBoxCount -= 1;

	localStorage.setItem('bigBoxCount', bigBoxCount);

	let storage = getStorage();

	// powerPointsDraw(3, "big-box");

	let generalResources = generalDraw(3, "big-box");

	storage.coins += parseInt(generalResources.totalCoinsReward) || 0;
	storage.powerPoints += parseInt(generalResources.totalPowerPointsReward) || 0;
	storage.credits += parseInt(generalResources.totalCreditsReward) || 0;
	storage.gems += parseInt(generalResources.totalGemsReward) || 0;
	
	localStorage.setItem('coins', storage.coins);
	localStorage.setItem('powerPoints', storage.powerPoints);
	localStorage.setItem('credits', storage.credits);
	localStorage.setItem('gems', storage.gems);

    updateResources();

	openingDelay();
}

function openMegaBox() {

	let megaBoxCount = localStorage.getItem('megaBoxCount') || 0;

	if (megaBoxCount <= 0) {
		return window.location.href = "/BrawlStarsSimulator/shop";
	}

	megaBoxCount -= 1;

	localStorage.setItem('megaBoxCount', megaBoxCount);
	
	let storage = getStorage();

	// powerPointsDraw(5, "mega-box");

	let generalResources = generalDraw(5, "mega-box");

	storage.coins += parseInt(generalResources.totalCoinsReward) || 0;
	storage.powerPoints += parseInt(generalResources.totalPowerPointsReward) || 0;
	storage.credits += parseInt(generalResources.totalCreditsReward) || 0;
	storage.gems += parseInt(generalResources.totalGemsReward) || 0;
	
	localStorage.setItem('coins', storage.coins);
	localStorage.setItem('powerPoints', storage.powerPoints);
	localStorage.setItem('credits', storage.credits);
	localStorage.setItem('gems', storage.gems);

    updateResources();

	openingDelay();
}

function getStorage() {
	let coins = parseInt(localStorage.getItem('coins')) || 0;
	let powerPoints = parseInt(localStorage.getItem('powerPoints')) || 0;
	let credits = parseInt(localStorage.getItem('credits')) || 0;
	let gems = parseInt(localStorage.getItem('gems')) || 0;
	let brawlers = JSON.parse(localStorage.getItem('brawlers')) || [];

	return { coins, powerPoints, credits, gems, brawlers };
}

function powerPointsDraw(count, type) {
	
}

function generalDraw(count, boxType) {

	// let fastMode = localStorage.geiItem('openingMode');
	let fastMode = true;

	let popoverBtn = getById('open-' + boxType);
	let popover = getById(boxType + '-reward');

	if (popover.matches(':popover-open')) {
		popoverBtn.setAttribute('popovertargetaction', 'show');
	} else {
		popoverBtn.setAttribute('popovertargetaction', 'toggle');
	}

	const max = drawTable.reduce((sum, item) => sum + item.chance, 0);
	const min = 0;

	let coinsReward = [], powerPointsReward = [], creditsReward = [], gemsReward = [], skillsReward = [], brawlersReward = [];

	let totalCoinsReward = 0, totalPowerPointsReward = 0, totalCreditsReward = 0, totalGemsReward = 0;

	for (let i = 0; i < count; i++) {

		let random = parseFloat((Math.random() * (max - min) + min).toFixed(2))
		console.log(random);
		
		let entry = getTable(random);

		console.log("Item Sorteado: " + entry.type);
		
		if (fastMode) {
		
			if (entry.item.includes('lowAmount')) {
				
				if (entry.type == "coins") {
					coinsReward.push(Math.floor(Math.random() * (121 - 30) + 30))
				}
	
				if (entry.type == "powerPoints") {
					powerPointsReward.push(Math.floor(Math.random() * (101 - 20) + 20))
				}
	
				if (entry.type == "credits") {
					creditsReward.push(Math.floor(Math.random() * (81 - 10) + 10))
				}
	
				if (entry.type == "gems") {
					gemsReward.push(Math.floor(Math.random() * (6 - 1) + 1))
				}
				
			}
	
			if (entry.item.includes('highAmount')) {
				
				if (entry.type == "coins") {
					coinsReward.push(entry.value);
				}
				
				if (entry.type == "powerPoints") {
					powerPointsReward.push(entry.value);
				}
				
				if (entry.type == "credits") {
					creditsReward.push(entry.value);
				}
				
				if (entry.type == "gems") {
					gemsReward.push(entry.value);
				}
			}
		}
	}

	let rewardList = queryAll('.reward-list');
	
	rewardList.forEach(list => {
		list.textContent = "";
	});

	if (fastMode) {
		totalCoinsReward = fastModeSum(coinsReward, "coins", boxType);
		totalPowerPointsReward = fastModeSum(powerPointsReward, "power-points", boxType);
		totalCreditsReward = fastModeSum(creditsReward, "credits", boxType);
		totalGemsReward = fastModeSum(gemsReward, "gems", boxType);
	}
	
	console.log(`Moedas: ${totalCoinsReward}; Pontos de Poder: ${totalPowerPointsReward}, Vales: ${totalCreditsReward}; Gemas: ${totalGemsReward}`);
	
	return { totalCoinsReward, totalPowerPointsReward, totalCreditsReward, totalGemsReward }
}

function fastModeSum(reward, type, boxType) {

	let total = reward.reduce((total, value) => total + value, 0)

	if (total == 0) return total = 0;

	let li = document.createElement('li');

	let img = document.createElement('img');
	img.classList = "p-2xs aspect-ratio resize-none w-16"
	img.setAttribute('src', 'assets/images/icon-' + type + '.png');
	img.setAttribute('background', + type)

	let div = document.createElement('div');
	div.classList = 'flex items-center grow h-16 bg-' + type;
	div.append(img)

	let span = document.createElement('span');
	span.textContent = total;

	li.append(div, span);

	let rewardList = getById(boxType + '-reward-list');

	rewardList.append(li);
;
	return total;
}

function getTable(random) {
	for (let entry of drawTable) {
		if (random < entry.chance) {
			console.log(entry.item)
			return entry;
		}
		random -= entry.chance;
	}
}


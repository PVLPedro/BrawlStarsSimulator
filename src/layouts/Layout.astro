	// Recursos
	{ item: "lowAmountCoins", chance: 41, type: "coins"},
	{ item: "lowAmountPowerPoints", chance: 31, type: "powerPoints"},
	{ item: "lowAmountCredits", chance: 21, type: "credits"},
	{ item: "lowAmountGems", chance: 5.8, type: "gems"},

	{ item: "highAmountCoins", chance: 0.2, type: "coins", value: 1000},
	{ item: "highAmountPowerPoints", chance: 0.1, type: "powerPoints", value: 1000},
	{ item: "highAmountCredits", chance: 0.1, type: "credits", value: 1000},
	{ item: "highAmountGems", chance: 0.1, type: "gems", value: 100},

	// Total de lowAmount = 95
	// Total de highAmount = 0.5

	// Total de Recursos = 95.5

	// Habilidades
	{ item: "gadget", chance: 1, type: "skill", name: "gadget" },
	{ item: "starPower", chance: 0.7, type: "skill", name: "starPower" },
	{ item: "hypercharge", chance: 0.3, type: "skill", name: "hypercharge" },

	// Total de Habilidades = 2
	// Total (até aqui) = 97.5

	// Brawlers
	{ item: "rareBrawler", chance: 0.8, type: "brawler", name: "rareBrawler"},
	{ item: "superRareBrawler", chance: 0.6, type: "brawler", name: "superRareBrawler"},
	{ item: "epicBrawler", chance: 0.5, type: "brawler", name: "epicBrawler"},
	{ item: "mythicBrawler", chance: 0.3, type: "brawler", name: "mythicBrawler"},
	{ item: "legendaryBrawler", chance: 0.2, type: "brawler", name: "legendaryBrawler"},
	{ item: "ultraLegendaryBrawler", chance: 0.1, type: "brawler", name: "ultraLegendaryBrawler"},

	// Total de Brawlers = 2.5

	// Total = 100
]

let bigBoxPurchase = getById('big-box-purchase');
bigBoxPurchase?.addEventListener('click', () => {
	confirmPurchase(30, bigBoxPurchase, "bigBoxCount", ".big-box-count");
})

let megaBoxPurchase = getById('mega-box-purchase');
megaBoxPurchase?.addEventListener('click', () => {
	confirmPurchase(80, megaBoxPurchase, "megaBoxCount", ".mega-box-count");
})

function confirmPurchase(value, button, item) {

	let currentGems = localStorage.getItem('gems');
	let currentCount = parseInt(localStorage.getItem(item));

	if (currentGems < value) {
		button.textContent = "Gemas Insuficientes";
		button.classList.remove('bg-buy', 'hover:bg-buy-hover');
		button.classList.add('bg-alert', 'hover:bg-alert-hover');
		return
	}

	currentGems -= value;
	currentCount += 1;

	localStorage.setItem('gems', currentGems);
	localStorage.setItem(item, currentCount);
	
	updateCount();
	updateResources();
}

function updateCount() {
	let display = queryAll('.count');

	display.forEach(element => {
		id = element.id;
		let storage = localStorage.getItem(id)
		element.textContent = "Quantidade: " + storage;
	})
}


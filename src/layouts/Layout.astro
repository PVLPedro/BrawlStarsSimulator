---
import Header from '../components/base/Header.astro'
import Sidebar from '../components/base/sidebar/Sidebar.astro'
import '../styles/global.css'
---

<!doctype html>
<html lang="pt-br">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="font-poppins bg-bg-secondary text-white p-bs">
		<Header />
		<Sidebar />
		<slot />
	</body>

	<script defer>

function getById(id) {
    return document.getElementById(id);
}

function updateCoins() {
    const coinsDisplay = getById('coins-display');

    let currentCoins = parseInt(localStorage.getItem('coins')) || 0;
    
    coinsDisplay.textContent = currentCoins;
}

const openBrawlBoxBtn = getById('brawl-box');
openBrawlBoxBtn.addEventListener('click', openBrawlBox);

const openBigBoxBtn = getById('big-box');
openBigBoxBtn.addEventListener('click', openBigBox);

const openMegaBoxBtn = getById('mega-box');
openMegaBoxBtn.addEventListener('click', openMegaBox);

const resetCoinsBtn = getById('reset-coins');
resetCoinsBtn.addEventListener('click', resetCoins);

function openBrawlBox() {
	
	let coins = localStorage.getItem('coins');
	let powerPoints = localStorage.getItem('powerPoints');
	let brawlers = JSON.parse(localStorage.getItem('brawlers')) || [];

	let box = 'box';

	powerPointsDraw(2, box);
	generalDraw(1, box);

    updateResources();
}

function openBigBox() {

	let bigBoxCount = parseInt(localStorage.getItem('bigBoxCount')) || 0;

	if (bigBoxCount === 0) {
		return;
	}
	
	let coins = localStorage.getItem('coins');
	let powerPoints = localStorage.getItem('powerPoints');
	let brawlers = JSON.parse(localStorage.getItem('brawlers')) || [];

	let box = 'box';

	powerPointsDraw(3, box);
	generalDraw(3, box)

    updateResources();
}

function openMegaBox() {
	
	let coins = localStorage.getItem('coins');
	let powerPoints = localStorage.getItem('powerPoints');
	let brawlers = JSON.parse(localStorage.getItem('brawlers')) || [];

	let box = 'box';

	powerPointsDraw(5, box);
	generalDraw(5, box)

    updateResources();
}

function powerPointsDraw(count, type) {
	
}

function generalDraw(count, type) {

	const max = drawTable.reduce((sum, item) => sum + item.chance, 0);
	const min = 0;

	let coinsReward = 0, powerPointsReward = 0, creditsReward = 0, gemsReward = 0;
	let skillsReward = [], brawlersReward = []

	for (let i = 0; i < count; i++) {

		let random = parseFloat((Math.random() * (max - min) + min).toFixed(2))
		console.log(random);
		
		let entry = getTable(random);

		console.log(entry.type);
		

		if (entry.item.includes('lowAmount')) {
			
			if (entry.type == "coins") {
				coinsReward += Math.floor(Math.random() * (150 - 30) + 20)
			}

			if (entry.type == "powerPoints") {
				powerPointsReward += Math.floor(Math.random() * (120 - 20) + 20)
			}

			if (entry.type == "credits") {
				creditsReward += Math.floor(Math.random() * (100 - 10) + 10)
			}

			if (entry.type == "gems") {
				gemsReward += Math.floor(Math.random() * (10 - 1) + 1)
			}
			
		}

		if (entry.item.includes('highAmount')) {
			
			if (entry.type == "coins") {
				coinsReward += entry.value;
			}
			
			if (entry.type == "powerPoints") {
				powerPointsReward += entry.value;
			}
			
			if (entry.type == "credits") {
				creditsReward += entry.value;
			}
			
			if (entry.type == "gems") {
				gemsReward += entry.value;
			}

		}

		if (entry.type == "skill") {
			skillsReward.push(entry.lenght)
		}

		if (entry.type == "brawler") {
			brawlersReward.push(entry.lenght)
		}

	}

	console.log(`Moedas: ${coinsReward}; Pontos de Poder: ${powerPointsReward}, Vales: ${creditsReward}; Gemas: ${gemsReward}; Habilidades: ${skillsReward}; Brawlers: ${brawlersReward}`);
	
}

function getTable(random) {
	for (let entry of drawTable) {
		if (random < entry.chance) {
			console.log(entry.item)
			return entry;
		}
		random -= entry.chance;
	}
}


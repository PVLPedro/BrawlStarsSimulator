function updateResources() {
	let display = queryAll('.count');

	display.forEach(element => {
		id = element.id;
		let storage = localStorage.getItem(id)
		element.textContent = "Quantidade: " + storage;
	})

    let coinsDisplay = getById('coins-display');
    let powerPointsDisplay = getById('power-points-display');
    let creditsDisplay = getById('credits-display');
    let gemsDisplay = getById('gems-display');

	coinsDisplay.textContent = localStorage.getItem('coins');

---
const { box, "img-alt": imgAlt} = Astro.props;
---

<div class="flex-1 flex items-center min-w-80 gap-xl p-bs rounded-sm bg-bg-secondary font-medium">
    <img src={`assets/images/${box}.png`} alt={imgAlt} class="h-20 w-20" />
    <span class="flex flex-col w-full gap-2xs">
        <slot />
    </span>
</div>
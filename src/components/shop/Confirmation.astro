---
import { X } from '@lucide/astro';

const { id } = Astro.props;
---

<div id={id} popover class="fixed flex-col justify-center items-center gap-bs top-1/2 left-1/2 -translate-1/2 rounded-lg backdrop:bg-backdrop backdrop:backdrop-blur-2xs bg-bg-secondary min-w-120 border-2 border-buy p-2xl text-white">
    <button popovertarget={id} class="absolute top-bs right-bs p-2xs bg-bg-primary hover:bg-bg-primary-hover cursor-pointer rounded-[50%]">
        <X />
    </button>
    <slot />
</div>
---
import UnorderedList from './UnorderedList.astro';
import ListItem from './ListItem.astro';

import { Toolbox, HandFist, CircleStar, ChartColumn, ShoppingCart } from '@lucide/astro';
---

<aside class="w-50 p-bs bg-bg-primary rounded-xl [&_svg]:size-6 [&_svg]:stroke-2">
    <UnorderedList>
        <ListItem text="Caixas" icon={Toolbox} href="/BrawlStarsSimulator/" link="" />
        <ListItem text="Brawlers" icon={HandFist} href="/BrawlStarsSimulator/brawlers" link="brawlers" />
        <ListItem text="Coleção" icon={CircleStar} href="/BrawlStarsSimulator/collection" link="collection" />
        <ListItem text="Chances" icon={ChartColumn} href="/BrawlStarsSimulator/drop-rates" link="drop-rates" />
        <ListItem text="Loja" icon={ShoppingCart} href="/BrawlStarsSimulator/shop" link="drop-rates" />
    </UnorderedList>
</aside>
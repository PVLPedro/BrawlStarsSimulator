---
import { LayoutDashboard, HandFist, CircleStar } from '@lucide/astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);

const activeClass = "bg-bg-primary-hover text-highligh";
---

<aside class="w-50 p-bs bg-bg-primary rounded-xl [&_svg]:size-6 [&_svg]:stroke-2">
    <ul class="flex flex-col gap-bs *:flex *:rounded-bs *:hover:bg-bg-primary-hover *:*:flex *:*:gap-bs *:*:p-bs *:*:text-white *:*:w-full">
        <li class={currentPath === "" ? activeClass : ""}>
            <a href="/">
                <LayoutDashboard />
                <span>Geral</span>
            </a>
        </li>
        <li class={currentPath === "brawlers" ? activeClass : ""}>
            <a href="/brawlers">
                <HandFist />
                <span>Brawlers</span>
            </a>
        </li>
        <li class={currentPath === "collection" ? activeClass : ""}>
            <a href="/collection">
                <CircleStar />
                <span>Coleção</span>
            </a>
        </li>
    </ul>
</aside>